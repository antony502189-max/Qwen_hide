<Window x:Class="QwenWorkOverlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Qwen Work Overlay" WindowStyle="None" ResizeMode="CanResize" MinWidth="420" MinHeight="280" Background="#111827">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{StaticResource Bar}" MouseLeftButtonDown="DragBar_MouseLeftButtonDown"><DockPanel LastChildFill="True"><TextBlock Text="QWEN WORK OVERLAY" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="9,0" FontSize="11"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="MixButton" Content="MIX" Click="Mix_Click"/><Button x:Name="ClickButton" Content="CLICK" Click="Click_Click"/><Button x:Name="PrivacyButton" Content="PRIVACY" Click="Privacy_Click"/><Button Content="TEST" Click="CaptureTest_Click"/><Button Content="⚙" Click="Settings_Click"/><Button Content="—" Click="Minimize_Click"/><Button Content="×" Click="Close_Click"/></StackPanel></DockPanel></Border>
  <wv:WebView2 x:Name="Browser" Grid.Row="1"/>
  <Border Grid.Row="2" Background="#1C2028"><TextBlock x:Name="StatusText" Text="Starting…" Foreground="#B8C1CC" VerticalAlignment="Center" Margin="8,0" FontSize="10"/></Border>
 </Grid>
</Window>
