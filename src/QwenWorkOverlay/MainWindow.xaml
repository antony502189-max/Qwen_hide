<Window x:Class="QwenWorkOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qwen Desktop Controller"
        Width="470" Height="330" MinWidth="430" MinHeight="300"
        WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip"
        Background="#111827" Foreground="#E6EDF3" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Qwen Desktop Controller" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#1C2028" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="NativeStatusText" Text="Searching for the installed Qwen Desktop…" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="NativeDetailsText" Foreground="#AAB4C3" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#1C2028" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="WindowStatusText" Text="Window controls: waiting for Qwen" TextWrapping="Wrap"/>
                <TextBlock x:Name="AudioStatusText" Text="Audio mix: idle" Foreground="#AAB4C3" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="PrivacyStatusText" Text="Capture privacy: native-mode status pending" Foreground="#AAB4C3" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <Button Content="Attach / Open Qwen" Click="Attach_Click"/>
            <Button Content="Show Qwen" Click="ShowQwen_Click"/>
            <Button Content="Toggle Click-through" Click="Click_Click"/>
            <Button Content="Toggle Privacy Host" Click="Privacy_Click"/>
            <Button Content="Validate GDI Capture" Click="PrivacyGdiProbe_Click"/>
            <Button Content="Validate PrintWindow" Click="PrivacyPrintWindowProbe_Click"/>
            <Button Content="Validate Native Capture APIs" Click="PrivacyNativeProbe_Click"/>
            <Button Content="Settings" Click="Settings_Click"/>
            <Button Content="Diagnostics" Click="Diagnostics_Click"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" Foreground="#8FA0B5" TextWrapping="Wrap">
            This controller does not embed qwen.ai. It attaches to the Qwen Desktop application already installed on this PC. Close this panel to keep the controller running in the tray.
        </TextBlock>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B8C1CC" Text="Ready"/>
            <Button DockPanel.Dock="Right" Content="Exit controller" Click="Exit_Click"/>
        </DockPanel>
    </Grid>
</Window>
