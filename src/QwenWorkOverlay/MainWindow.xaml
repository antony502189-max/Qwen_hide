<Window x:Class="QwenWorkOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контроллер Qwen Desktop"
        Width="560" Height="370" MinWidth="500" MinHeight="330"
        WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip"
        Background="#111827" Foreground="#E6EDF3" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Контроллер Qwen Desktop" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#1C2028" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="NativeStatusText" Text="Поиск установленного Qwen Desktop…" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="NativeDetailsText" Foreground="#AAB4C3" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#1C2028" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="WindowStatusText" Text="Управление окном: ожидание Qwen" TextWrapping="Wrap"/>
                <TextBlock x:Name="AudioStatusText" Text="Аудиомикс: ожидание" Foreground="#AAB4C3" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="PrivacyStatusText" Text="Защита демонстрации: проверка состояния" Foreground="#AAB4C3" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <Button Content="Подключить / открыть Qwen" Click="Attach_Click"/>
            <Button Content="Показать Qwen" Click="ShowQwen_Click"/>
            <Button Content="Сквозные клики" Click="Click_Click"/>
            <Button Content="Настройки" Click="Settings_Click"/>
            <Button Content="Диагностика" Click="Diagnostics_Click"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" Foreground="#8FA0B5" TextWrapping="Wrap">
            Контроллер не встраивает qwen.ai и не заменяет интерфейс Qwen. Он подключается к уже установленному Qwen Desktop. Закройте это окно, чтобы оставить контроллер работающим в системном трее.
        </TextBlock>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B8C1CC" Text="Готово"/>
            <Button DockPanel.Dock="Right" Content="Выйти из контроллера" Click="Exit_Click"/>
        </DockPanel>
    </Grid>
</Window>
