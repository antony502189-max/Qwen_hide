<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><UseSystemDrawing>true</UseSystemDrawing><Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QwenWorkOverlay</AssemblyName><RootNamespace>QwenWorkOverlay</RootNamespace>
    <PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
